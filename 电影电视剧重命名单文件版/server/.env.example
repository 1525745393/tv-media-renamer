# 复制为 .env 并填写后执行：docker compose up -d --build
# 生成随机 Token 示例：python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# 必填：API 鉴权 Token（所有请求须携带 Authorization: Bearer <token>）
API_TOKEN=

# 媒体目录（宿主机路径，挂载到容器 /media）
MEDIA_DIR=/volume1/media

# 可选：对外端口（默认 8123）
# PORT=8123

# 可选：容器内允许根目录（默认 /media）
# ALLOWED_ROOT=/media
